EMAILGENIUS_HOME=.emailgenius
EMAILGENIUS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/emailgenius
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXA_API_KEY=
EMAILGENIUS_OPENAI_CHAT_MODEL=gpt-5
EMAILGENIUS_OPENAI_EMBED_MODEL=text-embedding-3-small
EMAILGENIUS_OPENAI_FALLBACK_API_KEY=
EMAILGENIUS_OPENAI_FALLBACK_BASE_URL=
EMAILGENIUS_OPENAI_FALLBACK_CHAT_MODEL=
EMAILGENIUS_RESEARCH_MODEL=deepseek/deepseek-chat-v3.1
EMAILGENIUS_WRITER_MODEL=anthropic/claude-3.5-haiku
EMAILGENIUS_WRITER_FALLBACK_MODEL=anthropic/claude-sonnet-4.5
GOOGLE_SERVICE_ACCOUNT_JSON=
EMAILGENIUS_WORKSPACE_FOLDER_ID=
EMAILGENIUS_DRIVE_POLL_INTERVAL_SECONDS=60
EMAILGENIUS_IO_MODE=local
EMAILGENIUS_HOST=127.0.0.1
EMAILGENIUS_PORT=8080
# Webapp security: set EMAILGENIUS_ENV=prod and EMAILGENIUS_AUTH_TOKEN before
# exposing the app beyond localhost. Without a token every POST endpoint is
# open and triggers LLM spend.
EMAILGENIUS_ENV=dev
EMAILGENIUS_AUTH_TOKEN=
# CSRF: header-only double-submit cookie. Enabling requires templates that
# echo the emailgenius_csrf cookie value into the X-CSRF-Token request header.
EMAILGENIUS_CSRF_ENABLED=
EMAILGENIUS_MAX_UPLOAD_BYTES=10485760
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=emailgenius
POSTGRES_PORT=5432
